# Kopieren nach .env.local und Schlüssel eintragen. Ohne Schlüssel läuft alles im Demo-Modus.

# Drehbuch-KI (Claude) – https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Sprecherstimmen (empfohlen) – https://elevenlabs.io → Profil → API Keys
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v3   (Standard; pro Figur überschreibbar)
# ELEVENLABS_DEFAULT_VOICE=          (Fallback-Voice-ID, falls eine Figur keine eigene hat)

# Alternative Stimmen + KI-Konzeptbilder – https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_IMAGE_MODEL=gpt-image-1

# Anbieter erzwingen (optional): claude|demo · elevenlabs|openai|none · openai|none
# STORY_PROVIDER=
# TTS_PROVIDER=
# IMAGE_PROVIDER=

# Eigener Chrome/Chromium für das Rendern (optional, sonst automatisch)
# REMOTION_BROWSER=
